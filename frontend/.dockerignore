# 构建上下文排除（frontend/）
# 关键：node_modules 必须排除。本地是 Windows 版依赖（含 win32 原生二进制），
# 若被 COPY 进 node:20-alpine 会覆盖镜像内 `npm ci` 装好的 linux 版依赖，
# 表现为 vite/rollup 的 native binding 加载失败，构建直接报错。
node_modules/
dist/
dist-ssr/

# Android 壳工程与打包脚本：只在本机出包，不进前端镜像（体积大且与镜像构建无关）
# 注意不能忽略 public/download/*.apk —— nginx 要靠它提供安装包下载
android/
capacitor.config.ts
scripts/

# 开发期 HTTPS 自签证书：仅本地调试用，不进生产镜像
certs/

# 各类历史验证产物
_shots/
_harness/
out/
.tmpshot/
.tmpbuild/
.tmp_vite_shot.log
_shot-app.cjs
_verify_swipe_tabs.py
inbox2.html

# 本地环境变量（前端暂无，占位防误纳）
.env
.env.*
!.env.example

*.log
.git/
.gitignore
Dockerfile
.dockerignore
