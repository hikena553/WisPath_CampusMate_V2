# 不上「backend/scripts/* + !db_*.py」白名单：新加一个 export_*.py / check_*.py 时
# 会被静默忽略，git status 看不见 —— db_migrate.py 当初就是这样差点没提交上去。
backend/scripts/_*.py
backend/scripts/*probe*.py
backend/scripts/*_shot*.py
backend/uv.out
backend/uv.err

