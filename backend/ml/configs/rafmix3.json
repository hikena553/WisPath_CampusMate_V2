{
  "run_name": "rafmix3",
  "model_name": "face_expression_net",
  "input_size": 64,
  "width_mult": 1.25,
  "use_se": true,
  "se_ratio": 8,
  "dropout": 0.3,
  "loss": "focal",
  "focal_gamma": 2.0,
  "use_class_weight": false,
  "balance_sampler": true,
  "sampler_power": 0.5,
  "train_file": "train_all.pt",
  "epochs": 50,
  "batch_size": 256,
  "lr": 0.003,
  "head_lr_mult": 3.0,
  "weight_decay": 0.0005,
  "optimizer": "adamw",
  "scheduler": "cosine",
  "warmup_epochs": 4,
  "min_lr": 1e-05,
  "label_smoothing": 0.1,
  "grad_clip": 5.0,
  "amp": true,
  "aug_hflip": 0.5,
  "aug_rotation": 12.0,
  "aug_translate": 0.12,
  "aug_brightness": 0.25,
  "aug_scale": 0.12,
  "random_erase_prob": 0.3,
  "random_erase_min": 0.02,
  "random_erase_max": 0.2,
  "mixup_alpha": 0.0,
  "ema_decay": 0.999,
  "tta": true,
  "early_stop_patience": 0,
  "val_split": 0.1,
  "seed": 42,
  "num_workers": 0,
  "preload": true,
  "device": "auto"
}