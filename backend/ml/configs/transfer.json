{
  "run_name": "transfer",
  "model_name": "mobilenet_v3_small",
  "pretrained": true,
  "imagenet_norm": true,
  "input_size": 96,
  "dropout": 0.2,
  "epochs": 40,
  "batch_size": 128,
  "lr": 0.0003,
  "head_lr_mult": 4.0,
  "weight_decay": 0.0001,
  "optimizer": "adamw",
  "scheduler": "cosine",
  "warmup_epochs": 3,
  "min_lr": 1e-06,
  "label_smoothing": 0.1,
  "grad_clip": 5.0,
  "use_class_weight": false,
  "amp": true,
  "aug_hflip": 0.5,
  "aug_rotation": 10.0,
  "aug_translate": 0.08,
  "aug_brightness": 0.2,
  "aug_scale": 0.1,
  "random_erase_prob": 0.25,
  "random_erase_min": 0.02,
  "random_erase_max": 0.2,
  "mixup_alpha": 0.0,
  "ema_decay": 0.999,
  "tta": true,
  "early_stop_patience": 0,
  "val_split": 0.1,
  "seed": 42,
  "num_workers": 0,
  "preload": true,
  "device": "auto"
}