# ========== WisPath CampusMate 环境配置模板 ==========
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 密钥生成：python -c "import secrets; print(secrets.token_hex(32))"

# 运行环境：development / production（生产环境禁用限流 TESTING 旁路）
ENV=development

# 数据库连接（生产环境禁止 root 弱口令，建议专用账号 + 强密码）
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/smart_campus

# JWT 签名密钥：必须 >= 32 位随机值，禁止使用占位符
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 通义千问 / 百炼兼容模式（真实 Key 只放 .env，轮换后立即替换）
LLM_API_KEY=sk-sp-your-token-plan-api-key
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
LLM_MODEL=deepseek-v4-flash-0731
LLM_AGENT_MODEL=deepseek-v4-flash-0731
LLM_VISION_MODEL=qwen3.8-max
LLM_AGENT_TEMPERATURE=0.7
LLM_AGENT_MAX_TOKENS=10000