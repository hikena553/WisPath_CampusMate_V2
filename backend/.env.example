# ========== WisPath CampusMate 环境配置模板 ==========
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 密钥生成：python -c "import secrets; print(secrets.token_hex(32))"

# 运行环境：development / production（生产环境禁用限流 TESTING 旁路）
ENV=development

# ========== 数据库连接（两条，职责不同，勿混用）==========
# 运行时连接：只授予 SELECT/INSERT/UPDATE/DELETE 的账号（本项目为 campus_rw）。
# 应用被注入时也改不了表结构 —— 这是这套配置存在的唯一理由。
DATABASE_URL=mysql+pymysql://campus_rw:your_rw_password@localhost:3306/smart_campus?charset=utf8mb4

# 结构变更连接：仅 Alembic 迁移与启动期 schema 对账使用（campus_ddl，需 DDL 权限）。
# 留空则回落到 DATABASE_URL（单账号开发机可用，生产不建议）。
MIGRATION_DATABASE_URL=mysql+pymysql://campus_ddl:your_ddl_password@localhost:3306/smart_campus?charset=utf8mb4

# 启动时是否自动 alembic upgrade head。
#   单机 / 首次部署：true，开箱即跑
#   多副本 / 流水线发布：false，改由发布步骤执行一次迁移（否则 N 个副本抢同一把 DDL 锁，
#   且某个副本迁移失败会直接起不来，而不是等流水线回滚）
AUTO_MIGRATE=true

# 账号创建脚本（幂等，可反复跑来轮换密码）：
#   python backend/scripts/db_accounts.py --write-env
# 剩余 2 个账号按需创建：campus_ro（只读报表）、campus_backup（mysqldump 专用）

# JWT 签名密钥：必须 >= 32 位随机值，禁止使用占位符
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 千问 MaaS 平台（OpenAI 兼容模式端点；真实 Key 只放 .env，轮换后立即替换）
LLM_API_KEY=sk-your-maas-api-key
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-maas-api-key
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_AGENT_MODEL=qwen3.7-flash-2026-07-15
LLM_VISION_MODEL=qwen3.8-max
LLM_AGENT_TEMPERATURE=0.7
LLM_AGENT_MAX_TOKENS=10000
