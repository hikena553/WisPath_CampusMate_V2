# ============================================================
# Smart Campus 部署环境变量模板
# 使用方法：复制为 .env 并填写真实值（.env 已被 .gitignore 排除，不会入库）
#   cp .env.example .env
# 生成 SECRET_KEY：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=smart_campus
MYSQL_USER=campus
MYSQL_PASSWORD=change-me-db-password

# ---------- 应用 ----------
# JWT 签名密钥：必须 ≥32 位随机串，勿使用示例值
SECRET_KEY=please-generate-a-random-64-hex-string

# LLM（可选；不配置则 AI 对话/分析类功能不可用，其余功能正常）
LLM_API_KEY=
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
LLM_AGENT_MODEL=deepseek-v4-flash-0731
LLM_AGENT_TEMPERATURE=0.7
LLM_AGENT_MAX_TOKENS=10000

# 外部资讯源令牌（可选）
GITHUB_TOKEN=
GITEE_TOKEN=

# ---------- 部署 ----------
# nginx 对外端口
NGINX_PORT=80
# uvicorn worker 数：默认 1（周期任务由应用进程内调度，多 worker 会重复执行）
UVICORN_WORKERS=1