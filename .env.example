# ============================================================
# Smart Campus 部署环境变量模板
# 使用方法：复制为 .env 并填写真实值（.env 已被 .gitignore 排除，不会入库）
#   cp .env.example .env
# 生成 SECRET_KEY：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=smart_campus
MYSQL_USER=campus
MYSQL_PASSWORD=change-me-db-password

# ---------- 应用 ----------
# JWT 签名密钥：必须 ≥32 位随机串，勿使用示例值
SECRET_KEY=please-generate-a-random-64-hex-string
ENV=production

# ---------- 时区 ----------
# 容器默认 UTC，不设置会让课表/日程/周期任务整体差 8 小时
TZ=Asia/Shanghai

# ---------- LLM ----------
# 不配置则 AI 对话/分析类功能不可用，其余功能正常。
# ⚠️ 以下默认值必须与 backend/app/core/config.py 保持一致，否则 .env 漏写某一项时
#    线上会静默切换到另一套模型，AI 行为与本地开发环境对不上。
# ⚠️ 首次部署请逐项写死为本地 backend/.env 的值，不要依赖默认值。
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3.8-27b
LLM_AGENT_MODEL=qwen3.8-27b
LLM_VISION_MODEL=qwen3.8-max
LLM_AGENT_TEMPERATURE=0.7
LLM_AGENT_MAX_TOKENS=10000

# ---------- 语音 / 短信 / 第三方登录（可选，按需启用）----------
# 与本地 backend/.env 对齐。不配置时下列功能在线上不可用，其余功能正常。
# 语音（ASR/TTS）：本地若单独配置了语音网关，必须整组透传，否则线上语音通话不可用
VOICE_API_KEY=
VOICE_BASE_URL=
# 站点根地址：QQ 互联回跳、短信登录落地页
FRONTEND_BASE_URL=
# 手机号短信验证码登录：SMS_PROVIDER=aliyun 或 tencent；留空则生产环境拒绝短信登录
SMS_PROVIDER=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# QQ 互联 OAuth 登录
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=

# 外部资讯源令牌（可选）
GITHUB_TOKEN=
GITEE_TOKEN=

# ---------- 部署 ----------
# nginx 对外端口
NGINX_PORT=80
NGINX_SSL_PORT=443
# 站点配置：默认 HTTP 版；执行 deploy/enable_https.sh 后会自动改为
# ./deploy/nginx.ssl.conf（脚本会改这一行，无需手动编辑）
NGINX_CONF=./deploy/nginx.conf
# uvicorn worker 数：默认 1（周期任务由应用进程内调度，多 worker 会重复执行）
UVICORN_WORKERS=1
# 单机部署 true：容器启动时自动 alembic upgrade head
# 多副本/流水线部署必须 false：迁移由发布步骤用 DDL 账号单独执行一次
AUTO_MIGRATE=true
# 迁移连接串：留空则回落到 DATABASE_URL（单机部署够用）。
# 要落实「应用账号无 DDL 权限」，填独立的 campus_ddl 连接串（见 docs/数据库规范.md §5）
MIGRATION_DATABASE_URL=

# ---------- 可观测性（可选）----------
LOG_LEVEL=INFO
SENTRY_DSN=
