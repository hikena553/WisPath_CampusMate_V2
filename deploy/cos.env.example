# 腾讯云 COS 安装包发布配置模板（无真实密钥，可入库）
#
# 使用方式：复制到项目根目录并改名为 .cos.env，再填入真实密钥（.cos.env 已被 .gitignore 忽略）：
#   cp deploy/cos.env.example .cos.env
#   chmod 600 .cos.env
#   chown www:www .cos.env        # 定时任务以 www 用户运行，需要可读
#
# frontend/scripts/publish-apk.mjs 与 deploy/cos-sync-apk.sh 都会读取该文件；
# 同名环境变量优先于文件中的值。

# 访问密钥（必填）。腾讯云控制台 → 访问管理 CAM → API 密钥管理 创建。
# 强烈建议使用只授予该桶上传/读取权限的子账号密钥，不要使用主账号密钥。
COS_SECRET_ID=
COS_SECRET_KEY=

# 存储桶名称（必填，形如 <bucket>-<APPID>）
COS_BUCKET=anzhuangbao-1441295645

# 存储桶地域（必填）
COS_REGION=ap-guangzhou

# 访问域名（可选，缺省为 https://<bucket>.cos.<region>.myqcloud.com）
COS_DOMAIN=https://anzhuangbao-1441295645.cos.ap-guangzhou.myqcloud.com

# 安装包对象前缀（可选，默认 apk）
COS_APK_PREFIX=apk
